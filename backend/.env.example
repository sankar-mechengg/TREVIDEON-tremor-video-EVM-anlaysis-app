# Hosted API settings (Railway -> Variables)
TREVIDEON_MODE=hosted
TREVIDEON_EXECUTOR=modal            # modal = GPU jobs on Modal; local = this container's CPU
TREVIDEON_CORS=https://trevideon.vercel.app   # the frontend origin(s), comma-separated
TREVIDEON_TTL_MIN=60
TREVIDEON_MAX_UPLOAD_MB=1024
TREVIDEON_MAX_SEGMENT_S=60
TREVIDEON_MAX_HEIGHT=1080
# Modal credentials (only with TREVIDEON_EXECUTOR=modal): create with `modal token new`
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
